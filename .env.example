# Multi-Cloud & Virtualized Infrastructure Provisioning Engine
# Environment Configuration Template

APP_NAME="Multi-Cloud & Virtualized Infrastructure Provisioning Engine"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="production"

HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# SQLite Database Storage Path
DB_PATH="./provisioner.db"

# Terraform Orchestration Settings
TERRAFORM_BIN="terraform"
TERRAFORM_RUN_DIR="./runs"
TERRAFORM_TEMPLATES_DIR="./terraform/templates"
SIMULATE_TERRAFORM=false

# Worker Concurrency & Polling
WORKER_POLL_INTERVAL_SECONDS=0.5
MAX_CONCURRENT_JOBS=5
ENABLE_BACKGROUND_WORKER=true

# Resource Ceiling Guardrails
DEFAULT_MAX_VCPU_PER_REQUEST=64
DEFAULT_MAX_RAM_GB_PER_REQUEST=256
DEFAULT_MAX_STORAGE_GB_PER_REQUEST=2048
DEFAULT_MAX_NODES_PER_REQUEST=20
